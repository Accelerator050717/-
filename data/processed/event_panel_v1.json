  "formulas": {
    "event_annual_revenue_growth_yoy": "current annual revenue / prior annual revenue - 1; denominator positive",
    "event_annual_profit_margin_change_yoy": "current annual profit/revenue minus prior annual profit/revenue",
    "event_annual_cfo_margin_change_yoy": "current annual operating cash flow/revenue minus prior annual operating cash flow/revenue",
    "event_annual_profit_change_to_assets": "(current annual net income - prior annual net income) / current same-year-end Assets",
    "event_annual_cfo_to_assets_change_yoy": "current annual CFO/same-year-end Assets minus prior annual CFO/same-year-end Assets",
    "event_balance_liabilities_ratio_change_yoy": "latest liabilities/assets minus prior-year liabilities/assets; ratios matched within each accession/end",
    "event_balance_equity_ratio_change_yoy": "latest stockholders equity/assets minus prior-year stockholders equity/assets; ratios matched within each accession/end",
    "event_sessions_since_new_balance": "NYSE sessions since first usable session strictly after the filing that advanced the latest original balance-sheet period",
    "event_sessions_since_new_annual": "NYSE sessions since first usable session strictly after the original 10-K filing that advanced the latest annual period",
    "event_new_balance_filed_5d": "1 when new balance-period event age is 0-4 sessions, otherwise 0 after coverage begins",
    "event_new_balance_filed_20d": "1 when new balance-period event age is 0-19 sessions, otherwise 0 after coverage begins",
    "event_new_annual_filed_5d": "1 when new annual-period event age is 0-4 sessions, otherwise 0 after coverage begins",
    "event_new_annual_filed_20d": "1 when new annual-period event age is 0-19 sessions, otherwise 0 after coverage begins",
    "event_financial_amendment_filed_20d": "1 if an eligible 10-K/A or 10-Q/A containing selected financial facts became usable in last 20 sessions; distinct from new-period events"
  },
